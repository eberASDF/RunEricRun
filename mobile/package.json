{
  "name": "runericrun-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test:game": "tsc --ignoreConfig src/game.ts src/scoreStore.ts src/supabaseGateway.ts --target es2020 --module commonjs --outDir dist-test --skipLibCheck && node --test tests/*.test.cjs",
    "web": "expo start --web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.75.1",
    "expo": "^58.0.19",
    "expo-blur": "~58.0.5",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "2.0.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
